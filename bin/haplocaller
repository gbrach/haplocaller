#!/bin/sh
# Launcher: uses the private environment made by install.sh, else the python3 on PATH.
src=$0
while [ -L "$src" ]; do
    dir=$(cd "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case $src in /*) ;; *) src=$dir/$src ;; esac
done
here=$(cd "$(dirname "$src")/.." && pwd)
if [ -x "$here/.venv/bin/python" ]; then py="$here/.venv/bin/python"; else py=python3; fi
exec "$py" "$here/bin/haplocaller.py" "$@"
